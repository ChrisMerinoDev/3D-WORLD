# Base URL the frontend uses to reach the data API.
# In the default single-deploy setup the API is served by Next.js Route Handlers,
# so this can stay as the relative default. Override only if the backend is
# deployed separately.
NEXT_PUBLIC_API_BASE_URL=/api

# Cesium ion access token (FREE — create one at https://cesium.com/ion).
# When set, the globe uses Cesium World Terrain + Bing satellite imagery.
# When empty, it falls back to free Esri World Imagery (no token, still real
# satellite imagery). Safe to expose (client-side, scoped to imagery/terrain).
NEXT_PUBLIC_CESIUM_ION_TOKEN=
